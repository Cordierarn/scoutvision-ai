# Variables d'environnement du SERVEUR (jamais envoyées au navigateur)
# Copier dans .env.local (ignoré par git) ou définir dans l'environnement de l'hébergeur.

# Rapports de scouting IA : lue uniquement par l'endpoint POST /api/scout-report (server/).
# Ne jamais la préfixer par VITE_ : ce préfixe l'exposerait dans le bundle (le build refuse).
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini du rapport (côté serveur). Absent : gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash
